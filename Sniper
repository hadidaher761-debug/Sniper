-- Infinite jump follows the current character across respawns.
local lastJumpAt = 0
connect(UIS.JumpRequest, function()
    if not settings.InfiniteJump or not focused or UIS:GetFocusedTextBox() then return end
    local now = os.clock()
    if now - lastJumpAt < 0.12 then return end
    local character = me.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or humanoid.Sit or not root or root.Anchored then return end
    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Swimming or state == Enum.HumanoidStateType.Climbing then return end
    if humanoid.FloorMaterial == Enum.Material.Air then
        lastJumpAt = now
        local gravity = math.max(workspace.Gravity, 0)
        local speed = humanoid.UseJumpPower and humanoid.JumpPower
            or math.sqrt(2 * gravity * math.max(humanoid.JumpHeight, 0))
        if speed <= 0 then return end
        local velocity = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(velocity.X, speed, velocity.Z)
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- Apply speed to both the custom entity attribute and Roblox Humanoid.
local speedHumanoid = nil
local originalSpeed = nil
local originalSpeedAttribute = nil
local speedApplied = false
local speedPropertyConnection = nil
local changingSpeed = false
local function restoreSpeed()
    if speedApplied then
        speedApplied = false
        me:SetAttribute("WalkSpeed", originalSpeedAttribute)
        if speedHumanoid and speedHumanoid.Parent and originalSpeed then
            speedHumanoid.WalkSpeed = originalSpeed
        end
    end
    speedApplied = false
end
local function applySpeed()
    local humanoid = me.Character and me.Character:FindFirstChildOfClass("Humanoid")
    if humanoid ~= speedHumanoid then
        restoreSpeed()
        if speedPropertyConnection then speedPropertyConnection:Disconnect() speedPropertyConnection = nil end
        speedHumanoid = humanoid
        if humanoid then
            speedPropertyConnection = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                if speedApplied and settings.CustomSpeed and not changingSpeed and humanoid.WalkSpeed ~= settings.PlayerSpeed then
                    changingSpeed = true
                    humanoid.WalkSpeed = settings.PlayerSpeed
                    changingSpeed = false
                end
            end)
        end
        originalSpeed = humanoid and humanoid.WalkSpeed or nil
        originalSpeedAttribute = me:GetAttribute("WalkSpeed")
    end
    if settings.CustomSpeed and humanoid and humanoid.Health > 0 then
        if not speedApplied then
            originalSpeed = humanoid.WalkSpeed
            originalSpeedAttribute = me:GetAttribute("WalkSpeed")
        end
        speedApplied = true
        if me:GetAttribute("WalkSpeed") ~= settings.PlayerSpeed then
            me:SetAttribute("WalkSpeed", settings.PlayerSpeed)
        end
        if humanoid.WalkSpeed ~= settings.PlayerSpeed then humanoid.WalkSpeed = settings.PlayerSpeed end
    elseif speedApplied then
        restoreSpeed()
    end
end
connect(RunService.PreSimulation, applySpeed)
RunService:BindToRenderStep("SniperDuelsSpeed", Enum.RenderPriority.Input.Value - 1, applySpeed)
