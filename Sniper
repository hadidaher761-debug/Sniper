local function teamOf(p) return p:GetAttribute("Team") or p.Team end
local function validEnemy(p, forESP)
    if not forESP and type(p) == "table" and not settings.TargetBots then return nil end
    if p == me or p.Parent ~= Players then return nil end
    local ownWorld, otherWorld = me:GetAttribute("World"), p:GetAttribute("World")
    local ownRoom, otherRoom = me:GetAttribute("GameRoom"), p:GetAttribute("GameRoom")
    if ownWorld ~= nil and otherWorld ~= nil and ownWorld ~= otherWorld then return nil end
    if ownRoom ~= nil and otherRoom ~= nil and ownRoom ~= otherRoom then return nil end
    local ownTeam, otherTeam = teamOf(me), teamOf(p)
    -- This arcade room assigns every participant Team3; it is not a friendship filter.

    local c = p.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    local entityHealth = p:GetAttribute("Health")
    if p:GetAttribute("State") == "Dead" or (type(entityHealth) == "number" and entityHealth <= 0) then return nil end
    local head = c and c:FindFirstChild("Head")
    if not c or not c:IsDescendantOf(workspace) or (h and h.Health <= 0) or (not h and type(p) ~= "table")
        or not head or not head:IsA("BasePart") then return nil end

    local shield = p:GetAttribute("TempShield")

    return head, c, {Health = type(entityHealth) == "number" and entityHealth or (h and h.Health or 100)}
end
local function visible(camera, part)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = {camera}
    if me.Character then table.insert(excluded, me.Character) end
    params.FilterDescendantsInstances = excluded
    local hit = workspace:Raycast(camera.CFrame.Position, part.Position - camera.CFrame.Position, params)
    local targetModel = part.Parent
    local ancestor = targetModel
    while ancestor and ancestor ~= workspace do
        if ancestor:GetAttribute("FakeUserId") ~= nil then targetModel = ancestor break end
        ancestor = ancestor.Parent
    end
    return not hit or hit.Instance:IsDescendantOf(targetModel)
end

