RunService:BindToRenderStep(binding, Enum.RenderPriority.Last.Value + 100, function()
    local camera = workspace.CurrentCamera
    if not camera then release() return end
    local center = camera.ViewportSize / 2
    fovCircle.Position = UDim2.fromOffset(center.X, center.Y)
    fovCircle.Size = UDim2.fromOffset(settings.FOVRadius * 2, settings.FOVRadius * 2)
    fovCircle.Visible = settings.FOVEnabled and settings.Aim and not paused
    diagnosticTimer = diagnosticTimer + 1
    diagnostics.Visible = settings.Diagnostics
    if settings.Diagnostics and diagnosticTimer % 12 == 0 then
        local playerCount, botCount = 0, 0
        for candidate in pairs(entries) do
            if validEnemy(candidate, true) then
                if type(candidate) == "table" then botCount = botCount + 1 else playerCount = playerCount + 1 end
            end
        end
        diagnostics.Text = "Players: " .. playerCount .. "  /  Bots: " .. botCount
            .. "\nPreset: " .. settings.Preset .. " (" .. settings.ShotInterval .. "s)  /  " .. saveState
    end
    for p, e in pairs(entries) do
        local head, c, h = validEnemy(p, true)
        local isBot = type(p) == "table"
        local distance = head and (camera.CFrame.Position - head.Position).Magnitude or 0
        local show = ((isBot and settings.BotESP) or (not isBot and settings.ESP)) and head ~= nil
            and (settings.ESPMaxDistance == 0 or distance <= settings.ESPMaxDistance)
        local hasLabel = settings.ESPNames or settings.ESPHealth or settings.ESPDistance
        e.hl.Enabled = show and (settings.ESPHighlights or settings.ESPOutline)
        e.bb.Enabled = show and hasLabel
        if show then
            local color = Color3.fromHex(isBot and settings.BotColor or settings.PlayerColor)
            e.hl.FillColor = color
            e.hl.OutlineColor = Color3.fromHex(settings.OutlineColor)
            e.hl.FillTransparency = settings.ESPHighlights and (1 - settings.ESPFillOpacity / 100) or 1
            e.hl.OutlineTransparency = settings.ESPOutline and 0 or 1
            e.hl.DepthMode = settings.ESPThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
            e.label.TextColor3 = color
            e.label.TextSize = settings.ESPTextSize
            e.hl.Adornee = c
            e.bb.Adornee = head
            e.bb.AlwaysOnTop = settings.ESPThroughWalls
            e.bb.Size = UDim2.fromOffset(math.max(180, settings.ESPTextSize * 20), settings.ESPTextSize + 16)
            local parts = {}
            if settings.ESPNames then table.insert(parts, p.Name) end
            if settings.ESPHealth then table.insert(parts, math.ceil(h.Health) .. " HP") end
            if settings.ESPDistance then table.insert(parts, math.floor(distance) .. " studs") end
            e.label.Text = table.concat(parts, " | ")
        end
    end
    local now = os.clock()
    if held and now >= releaseAt then release() end
    local myHumanoid = me.Character and me.Character:FindFirstChildOfClass("Humanoid")
    if paused or not settings.Aim or not focused or UIS:GetFocusedTextBox()
        or (settings.HoldAim and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2))
        or not myHumanoid or myHumanoid.Health <= 0 then
        target = nil
        status.Text = paused and "Paused [F6 to resume]"
            or not settings.Aim and "Auto aim OFF"
            or not focused and "Game window unfocused"
            or UIS:GetFocusedTextBox() and "Typing: aim paused"
            or settings.HoldAim and "Hold right-click to aim"
            or "Waiting for respawn"
        release()
        return
    end
    local function aimable(p, retaining)
        local head = validEnemy(p)
        if not head then return nil end
        local point, onscreen = camera:WorldToViewportPoint(head.Position)
        local direction = head.Position - camera.CFrame.Position
        if direction.Magnitude < 0.01 then return nil end
        local alignment = camera.CFrame.LookVector:Dot(direction.Unit)
        -- Acquire in front. Keep an existing lock near the viewport edge.
        if alignment <= 0 or (not retaining and (not onscreen or point.Z <= 0)) then return nil end
        if not retaining and settings.FOVEnabled
            and (Vector2.new(point.X, point.Y) - center).Magnitude > settings.FOVRadius then return nil end
        if not visible(camera, head) then return nil end
        return head, alignment
    end
    -- Replace a bot lock if a real player becomes aimable.
    if type(target) == "table" then
        for candidate in pairs(entries) do
            if type(candidate) ~= "table" and aimable(candidate, false) then target = nil break end
        end
    end
    local head = target and aimable(target, true)
    if head then
        lastVisibleAt = now
    elseif target and validEnemy(target) and now - lastVisibleAt < retentionGrace then
        -- Brief occlusion: keep the target identity without aiming/firing through cover.
        release()
        acquiredAt = now
        status.Text = "Holding lock: " .. target.Name .. " | Obstructed"
        return
    else
        target = nil
        local bestAlignment = -1
        local bestClass = math.huge
        for p in pairs(entries) do
            local part, alignment = aimable(p, false)
            local class = type(p) == "table" and 1 or 0
            if part and (class < bestClass or (class == bestClass and alignment > bestAlignment)) then
                bestClass = class
                bestAlignment = alignment
                target = p
                head = part
            end
        end
        acquiredAt = now
        if head then lastVisibleAt = now end
    end
    if not head then status.Text = "Looking for a visible target in front" release() return end
    camera.CFrame = CFrame.lookAt(camera.CFrame.Position, head.Position)
    status.Text = "Locked: " .. target.Name .. (settings.Shoot and " | Auto shoot ON" or "")
    if not settings.Shoot then status.Text = "Locked: " .. target.Name .. " | Auto shoot OFF" release() return end
    if me:GetAttribute("combatPaused") == true or target:GetAttribute("combatPaused") == true then
        status.Text = "Locked: " .. target.Name .. " | Shooting paused by game"
        release()
        return
    end
    local targetCharacter = target.Character
    local shield = target:GetAttribute("TempShield")
    if (targetCharacter and targetCharacter:FindFirstChildOfClass("ForceField"))
        or (type(shield) == "number" and shield > 0) then status.Text = "Locked: " .. target.Name .. " | Shield active" release() return end
    -- Confirm lock over successive frames before the first shot.
    if now - acquiredAt < 0.05 then status.Text = "Locked: " .. target.Name .. " | Confirming aim" return end
    if now < nextShot or held then
        status.Text = "Locked: " .. target.Name .. " | Cooldown " .. string.format("%.2fs", math.max(0, nextShot - now))
        return
    end
    local delta = head.Position - camera.CFrame.Position
    if delta.Magnitude < 0.01 or camera.CFrame.LookVector:Dot(delta.Unit) < math.cos(math.rad(0.2)) then return end
    if not visible(camera, head) then status.Text = "Shot blocked by cover" release() return end
    if type(mouse1press) ~= "function" or type(mouse1release) ~= "function" then status.Text = "Mouse input API unavailable" return end
    mouse1press()
    status.Text = "Fired: " .. target.Name
    held = true
    releaseAt = now + 0.03
    nextShot = now + settings.ShotInterval
end)
