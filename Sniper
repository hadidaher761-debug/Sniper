local botAdapters = {}
local function botCharacter(entity)
    if entity:FindFirstChild("Head") then return entity end
    local collider = nil
    for _, child in ipairs(entity:GetChildren()) do
        if child:IsA("Model") and child:FindFirstChild("Head") then
            if child:FindFirstChildOfClass("Humanoid") then return child end
            collider = child
        end
    end
    return collider
end
local function discoverBot(entity)
    if not entity:IsA("Model") or not entity:IsDescendantOf(workspace) then return end
    if entity:GetAttribute("FakeUserId") == nil or entity:GetAttribute("_entityModel") == nil then return end
    if botAdapters[entity] then return end
    local adapter = setmetatable({
        GetAttribute = function(_, name) return entity:GetAttribute(name) end,
    }, {__index = function(_, key)
        if key == "Name" then return entity.Name .. " [BOT]" end
        if key == "Character" then return botCharacter(entity) end
        if key == "Parent" then return entity:IsDescendantOf(workspace) and Players or nil end
    end})
    botAdapters[entity] = adapter
    track(adapter)
end
local function scanBots()
    for _, instance in ipairs(workspace:GetDescendants()) do
        if instance:IsA("Model") and instance:GetAttribute("FakeUserId") ~= nil then discoverBot(instance) end
    end
    for entity, adapter in pairs(botAdapters) do
        if not entity:IsDescendantOf(workspace) then
            local e = entries[adapter]
            if e then e.hl:Destroy() e.bb:Destroy() entries[adapter] = nil end
            if target == adapter then target = nil release() end
            botAdapters[entity] = nil
        end
    end
end
